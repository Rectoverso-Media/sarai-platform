generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER & AUTH
// ==========================================
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String?
  name             String
  role             Role              @default(VIEWER)
  isEmailVerified  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  sessions         UserSession[]
  teamMemberships  TeamMember[]
  aiSessions       AiChatSession[]
  notifications    Notification[]

  teamId           String?
  team             Team?             @relation(fields: [teamId], references: [id])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. TEAM
// ==========================================
model Team {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // --- STRIPE & BILLING (Deliverable 1) ---
  stripeCustomerId     String?   @unique // ID Pelanggan di dashboard Stripe
  stripeSubscriptionId String?   @unique // ID Langganan aktif
  subscriptionPlan     String    @default("FREE") // FREE, PRO, ENTERPRISE
  subscriptionStatus   String    @default("INACTIVE") // ACTIVE, PAST_DUE, CANCELED
  trialEndsAt          DateTime?

  // --- USAGE TRACKING (Deliverable 2) ---
  aiTokensUsed         Int       @default(0)
  queriesUsed          Int       @default(0)
  rowsSynced           Int       @default(0) // Data dari Airbyte
  storageUsedMB        Int       @default(0) // Kapasitas penyimpanan
  
  members     TeamMember[]
  invitations TeamInvitation[]
  dashboards  Dashboard[]
  legacyUsers User[]
  usageLogs   UsageMetric[] // Relasi ke riwayat pemakaian
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      Role     @default(VIEWER)
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvitation {
  id          String   @id @default(uuid())
  teamId      String
  email       String
  token       String   @unique
  role        Role     @default(VIEWER)
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. DATA SOURCE
// ==========================================
model DataSource {
  id               String         @id @default(uuid())
  name             String
  sourceType       String
  status           String         @default("Connected")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  connections      Connection[]
  transfers        Transfer[]
  blends           BlendSourceConfig[]

  connectorName    String?
  airbyteSourceId  String?        @unique
  airbyteHost      String?
  trialStartsAt    DateTime?      @default(now())
  trialEndsAt      DateTime?      
  isTrialActive    Boolean?       @default(true)
}

model Connection {
  id              String               @id @default(uuid())
  dataSourceId    String
  airbyteSourceId String?              @unique
  status          String               @default("ACTIVE")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  dataSource      DataSource           @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  authLinks       ConnectionAuthLink[]
}

model ConnectionAuthLink {
  id           String     @id @default(uuid())
  connectionId String
  authType     String     // OAUTH, API_KEY, dll
  tokenData    String     // Encrypted
  createdAt    DateTime   @default(now())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. QUERY (Grup 4 Airbyte Synced Tables tidak di-define di ORM)
// ==========================================
model Query {
  id          String           @id @default(uuid())
  name        String
  description String?
  rawSql      String?
  builderData Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  executions  QueryExecution[]
  schedules   QuerySchedule?   // Opsional: Untuk Cron
}

model QueryExecution {
  id           String   @id @default(uuid())
  queryId      String
  status       String
  durationMs   Int?
  rowsReturned Int?
  errorMessage String?
  executedAt   DateTime @default(now())
  query        Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model QuerySchedule {
  id             String    @id @default(uuid())
  queryId        String    @unique
  cronExpression String
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  query          Query     @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. CUSTOM FIELDS
// ==========================================
model CustomField {
  id          String                @id @default(uuid())
  name        String
  dataType    String
  expression  String
  createdAt   DateTime              @default(now())
  mappings    CustomFieldMapping[]
}

model CustomFieldMapping {
  id            String      @id @default(uuid())
  customFieldId String
  targetTable   String
  createdAt     DateTime    @default(now())
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
}

// ==========================================
// 7. BLENDING
// ==========================================
model Blend {
  id          String              @id @default(uuid())
  name        String
  joinType    String              // INNER, LEFT, dll
  createdAt   DateTime            @default(now())
  sources     BlendSourceConfig[]
}

model BlendSourceConfig {
  id           String     @id @default(uuid())
  blendId      String
  dataSourceId String
  joinKey      String
  blend        Blend      @relation(fields: [blendId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. TRANSFER
// ==========================================
model Transfer {
  id             String              @id @default(uuid())
  name           String
  sourceId       String
  targetType     String              @default("Google Sheets")
  configData     Json                // Menyimpan ID Spreadsheet, sheet name, dll
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  source         DataSource          @relation(fields: [sourceId], references: [id])
  executions     TransferExecution[]
}

model TransferExecution {
  id          String   @id @default(uuid())
  transferId  String
  status      String
  recordsMoved Int?
  executedAt  DateTime @default(now())
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

// ==========================================
// 9. API QUERY
// ==========================================
model ApiQuery {
  id          String              @id @default(uuid())
  name        String
  endpointUrl String              @unique
  method      String              @default("GET")
  sqlTemplate String
  createdAt   DateTime            @default(now())
  executions  ApiQueryExecution[]
}

model ApiQueryExecution {
  id         String   @id @default(uuid())
  apiQueryId String
  statusCode Int
  latencyMs  Int
  calledAt   DateTime @default(now())
  apiQuery   ApiQuery @relation(fields: [apiQueryId], references: [id], onDelete: Cascade)
}

// ==========================================
// 10. DASHBOARD
// ==========================================
model Dashboard {
  id        String   @id @default(uuid())
  teamId    String?
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  widgetItems Widget[]

  widgets   Json?
  layout    Json?
}

model Widget {
  id          String    @id @default(uuid())
  dashboardId String
  title       String
  type        String    // bar, line, pie, kpi
  x           Int
  y           Int
  w           Int
  h           Int
  config      Json?     // Warna, metrik pilihan
  createdAt   DateTime  @default(now())
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

// ==========================================
// 11. EXPLORER
// ==========================================
model ExplorerSession {
  id          String   @id @default(uuid())
  userId      String
  activeTable String
  filters     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 12. AI (SARAI)
// ==========================================
model AiChatSession {
  id        String          @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  role      String        // user, assistant
  content   String
  createdAt DateTime      @default(now())
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InsightConfig {
  id          String   @id @default(uuid())
  targetTable String
  metric      String
  frequency   String   // daily, weekly
  createdAt   DateTime @default(now())
}

model InsightResult {
  id          String   @id @default(uuid())
  configId    String
  insightText String   @db.Text
  generatedAt DateTime @default(now())
}

// ==========================================
// 13 & 14. WAREHOUSE & TABLE MANAGER
// ==========================================
model WarehouseTable {
  id        String   @id @default(uuid())
  tableName String   @unique
  schema    Json
  createdAt DateTime @default(now())
}

model WarehouseData {
  id      String @id @default(uuid())
  tableId String
  rowData Json
}

model ManagedTable {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  rows      TableRow[]
}

model TableRow {
  id             String       @id @default(uuid())
  managedTableId String
  data           Json
  createdAt      DateTime     @default(now())
  table          ManagedTable @relation(fields: [managedTableId], references: [id], onDelete: Cascade)
}

// ==========================================
// 15. SUBSCRIPTION & USAGE TRACKING
// ==========================================
model Subscription {
  id          String             @id @default(uuid())
  planName    String             // misal: "Pro Tier"
  price       Decimal
  features    Json
  // Menghapus UserSubscription karena kita sekarang pakai data di dalam model Team
}

// Model ini digunakan untuk mencatat log historis (Audit pemakaian harian)
model UsageMetric {
  id          String   @id @default(uuid())
  teamId      String   // Diubah dari tenantId menjadi teamId
  metricType  String   // enum/string: AI_TOKEN, QUERY_RUN, AIRBYTE_SYNC
  value       Int      // Jumlah yang dipakai saat aksi terjadi
  loggedAt    DateTime @default(now())

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ==========================================
// 16. INTEGRATION
// ==========================================
model Integration {
  id        String   @id @default(uuid())
  name      String
  provider  String
  apiKey    String?
  createdAt DateTime @default(now())
}

model LinkedDocument {
  id            String   @id @default(uuid())
  integrationId String
  documentUrl   String
  createdAt     DateTime @default(now())
}

model Template {
  id          String   @id @default(uuid())
  name        String
  content     Json
  createdAt   DateTime @default(now())
}

// ==========================================
// 17. NOTIFICATION
// ==========================================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id        String   @id @default(uuid())
  metric    String
  condition String   // >, <, ==
  threshold Float
  createdAt DateTime @default(now())
}

model AlertTrigger {
  id          String   @id @default(uuid())
  ruleId      String
  triggeredValue Float
  triggeredAt DateTime @default(now())
}

// ==========================================
// 18. SYSTEM
// ==========================================
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   String?
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}

model InfrastructureNode {
  id        String   @id @default(uuid())
  name      String
  type      String
  status    String   @default("Online")
  uptime    String   @default("0d 0h")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model RateLimitConfig {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  limit     Int
  windowMs  Int
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}