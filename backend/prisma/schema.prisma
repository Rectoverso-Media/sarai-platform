datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String 
}

model DataSource {
  id          String   @id @default(uuid())
  name        String
  type        String
  host        String?
  connectorId String?  // Khusus buat ID dari Airbyte nanti
  status      String   @default("Connected")
  createdAt   DateTime @default(now())
}


model InfrastructureNode {
  id        String   @id @default(uuid())
  name      String   // misal: "Core Engine Alpha"
  type      String   // misal: "GPU Node", "CPU Node"
  status    String   @default("Online") // Online, Warning, Critical, Offline
  uptime    String   @default("0d 0h")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model TeamMember {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?  
  role      String   // Owner, Admin, Developer, Viewer
  status    String   @default("Active")
  avatar    String?
  createdAt DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  action    String   // Contoh: "USER_LOGIN", "NODE_DEPLOYED", "DATA_DELETED"
  actor     String   // Siapa pelakunya, misal: "Admin" atau "System"
  details   String?  // Info tambahan: "Menghapus Database Dummy"
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}

model Query {
  id          String   @id @default(uuid())
  name        String   // Contoh: "Rekap Ads Harian"
  description String?  // Deskripsi opsional
  rawSql      String?  // Untuk nyimpen kode SQL murni
  builderData Json?    // Untuk nyimpen konfigurasi Visual Builder (Drag & Drop)
  
  // Relasi ke tabel log dan jadwal
  executions  QueryExecution[]
  schedules   QuerySchedule[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QueryExecution {
  id           String   @id @default(uuid())
  queryId      String
  query        Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  
  status       String   // Status: "SUCCESS", "FAILED", "RUNNING"
  durationMs   Int?     // Lama eksekusi dalam milidetik (buat ngukur performa)
  rowsReturned Int?     // Jumlah baris data yang berhasil ditarik
  errorMessage String?  // Pesan error kalau query-nya gagal
  
  executedAt   DateTime @default(now())
}

model QuerySchedule {
  id             String   @id @default(uuid())
  queryId        String   @unique // 1 Query biasanya cuma punya 1 Jadwal utama
  query          Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  
  cronExpression String   // Format jadwal (Contoh: "0 0 * * *" untuk tiap tengah malam)
  isActive       Boolean  @default(true) // Tombol on/off jadwal
  
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}