generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER & AUTH
// ==========================================
model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password             String?
  name                 String
  role                 Role              @default(VIEWER)
  isEmailVerified      Boolean           @default(false)
  // 2FA
  isTwoFactorEnabled   Boolean           @default(false)
  twoFactorSecret      String?           // TOTP secret (encrypted)
  twoFactorTempToken   String?           // Short-lived token saat proses login 2FA
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  
  sessions             UserSession[]
  teamMemberships      TeamMember[]
  aiSessions           AiChatSession[]
  notifications        Notification[]

  teamId               String?
  team                 Team?             @relation(fields: [teamId], references: [id])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. TEAM
// ==========================================
model Team {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // --- STRIPE & BILLING (Deliverable 1) ---
  stripeCustomerId     String?   @unique // ID Pelanggan di dashboard Stripe
  stripeSubscriptionId String?   @unique // ID Langganan aktif
  subscriptionPlan     String    @default("FREE") // FREE, PRO, ENTERPRISE
  subscriptionStatus   String    @default("INACTIVE") // ACTIVE, PAST_DUE, CANCELED
  trialEndsAt          DateTime?

  // --- USAGE TRACKING (Deliverable 2) ---
  aiTokensUsed         Int       @default(0)
  queriesUsed          Int       @default(0)
  rowsSynced           Int       @default(0) // Data dari Airbyte
  storageUsedMB        Int       @default(0) // Kapasitas penyimpanan
  airbyteSyncsUsed     Int       @default(0) // Jumlah Airbyte sync jobs
  currentPeriodEnd     DateTime?             // Akhir billing period saat ini
  
  members     TeamMember[]
  invitations TeamInvitation[]
  dashboards  Dashboard[]
  legacyUsers User[]
  usageLogs   UsageMetric[]  // Relasi ke riwayat pemakaian
  integrations Integration[] // Relasi ke integrasi platform output
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      Role     @default(VIEWER)
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvitation {
  id          String   @id @default(uuid())
  teamId      String
  email       String
  token       String   @unique
  role        Role     @default(VIEWER)
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. DATA SOURCE
// ==========================================
model DataSource {
  id               String         @id @default(uuid())
  name             String
  sourceType       String
  status           String         @default("Connected")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  connections      Connection[]
  transfers        Transfer[]
  blends           BlendSourceConfig[]
  oauthToken       OAuthToken?    // Relasi ke OAuth token jika koneksi via OAuth

  connectorName    String?
  airbyteSourceId  String?        @unique
  airbyteHost      String?
  trialStartsAt    DateTime?      @default(now())
  trialEndsAt      DateTime?      
  isTrialActive    Boolean?       @default(true)
}

model Connection {
  id              String               @id @default(uuid())
  dataSourceId    String
  airbyteSourceId String?              @unique
  status          String               @default("ACTIVE")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  dataSource      DataSource           @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  authLinks       ConnectionAuthLink[]
  syncedData      SyncedData[]         // Data yang sudah di-sync dari koneksi ini
}

model ConnectionAuthLink {
  id           String     @id @default(uuid())
  connectionId String
  authType     String     // OAUTH, API_KEY, dll
  tokenData    String     // Encrypted
  createdAt    DateTime   @default(now())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. QUERY (Grup 4 Airbyte Synced Tables tidak di-define di ORM)
// ==========================================
model Query {
  id            String           @id @default(uuid())
  name          String
  description   String?
  rawSql        String?
  builderData   Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Scope & Tracking
  teamId        String?          // Query di-scope per team
  createdById   String?          // User yang membuat query

  // Source mapping (untuk eksekusi ke synced_data)
  connectionId  String?          // Koneksi Airbyte yang menjadi sumber data
  streamName    String?          // Nama stream/tabel spesifik yang di-query

  executions    QueryExecution[]
  schedules     QuerySchedule?   // Opsional: Untuk Cron
}

model QueryExecution {
  id              String   @id @default(uuid())
  queryId         String
  status          String
  durationMs      Int?
  rowsReturned    Int?
  errorMessage    String?
  resultSnapshot  Json?    // Snapshot hasil query (max 1000 baris) untuk dipakai Transfer & Warehouse
  executedAt      DateTime @default(now())
  query           Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model QuerySchedule {
  id             String    @id @default(uuid())
  queryId        String    @unique
  cronExpression String
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  query          Query     @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. CUSTOM FIELDS
// ==========================================
model CustomField {
  id          String                @id @default(uuid())
  name        String
  dataType    String
  expression  String
  createdAt   DateTime              @default(now())
  mappings    CustomFieldMapping[]
}

model CustomFieldMapping {
  id            String      @id @default(uuid())
  customFieldId String
  targetTable   String
  createdAt     DateTime    @default(now())
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
}

// ==========================================
// 7. BLENDING
// ==========================================
model Blend {
  id          String              @id @default(uuid())
  name        String
  joinType    String              // INNER, LEFT, dll
  createdAt   DateTime            @default(now())
  sources     BlendSourceConfig[]
}

model BlendSourceConfig {
  id           String     @id @default(uuid())
  blendId      String
  dataSourceId String
  joinKey      String
  blend        Blend      @relation(fields: [blendId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. TRANSFER
// ==========================================
model Transfer {
  id             String              @id @default(uuid())
  name           String
  sourceId       String
  targetType     String              @default("Google Sheets")
  configData     Json                // Menyimpan ID Spreadsheet, sheet name, dll
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  source         DataSource          @relation(fields: [sourceId], references: [id])
  executions     TransferExecution[]
}

model TransferExecution {
  id          String   @id @default(uuid())
  transferId  String
  status      String
  recordsMoved Int?
  executedAt  DateTime @default(now())
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

// ==========================================
// 9. API QUERY
// ==========================================
model ApiQuery {
  id              String              @id @default(uuid())
  name            String
  endpointUrl     String              // Hapus @unique — boleh ada 2 query ke URL yg sama
  method          String              @default("GET")   // GET, POST, PUT, DELETE, PATCH
  headers         Json?               // {"Authorization": "Bearer ...", ...}
  bodyTemplate    Json?               // Request body untuk POST/PUT
  authType        String              @default("NONE")  // NONE, API_KEY, BEARER, BASIC
  authConfig      Json?               // {"key": "...", "value": "..."}
  responseMapping Json?               // JSONPath mapping: {"field": "$.data.items[0].name"}
  createdAt       DateTime            @default(now())
  executions      ApiQueryExecution[]
}

model ApiQueryExecution {
  id               String   @id @default(uuid())
  apiQueryId       String
  statusCode       Int
  latencyMs        Int
  responseSnapshot Json?    // Simpan hasil response untuk preview
  calledAt         DateTime @default(now())
  apiQuery         ApiQuery @relation(fields: [apiQueryId], references: [id], onDelete: Cascade)
}

// ==========================================
// 10. DASHBOARD
// ==========================================
model Dashboard {
  id                 String       @id @default(uuid())
  teamId             String?
  name               String
  description        String?      // Deskripsi opsional
  isPublic           Boolean      @default(false)
  autoRefreshSeconds Int?         // null = auto-refresh off; angka = interval detik (30, 60, 300, dll)
  theme              String       @default("light") // light, dark, midnight
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  team               Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  widgetItems        Widget[]
  shareTokens        ShareToken[]

  widgets            Json?        // Definisi widget (legacy / blob storage)
  layout             Json?        // Layout grid (legacy / blob storage)
}

model Widget {
  id          String    @id @default(uuid())
  dashboardId String
  title       String
  type        String    // bar, line, pie, kpi, number, table, text, image
  x           Int
  y           Int
  w           Int
  h           Int
  config      Json?     // { dataSource, queryId, color, metric, imageUrl, text, ... }
  createdAt   DateTime  @default(now())
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

// Token untuk public sharing dengan expiry
model ShareToken {
  id          String    @id @default(uuid())
  dashboardId String
  token       String    @unique @default(uuid())
  expiresAt   DateTime  // Selalu ada expiry date
  createdAt   DateTime  @default(now())
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==========================================
// 11. EXPLORER
// ==========================================
model ExplorerSession {
  id          String   @id @default(uuid())
  userId      String
  activeTable String
  tableSource String   @default("synced_data") // synced_data | managed_table | query_execution
  filters     Json?    // [{ column, operator, value }]
  sorts       Json?    // [{ column, direction }]
  pageSize    Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 12. AI (SARAI)
// ==========================================
model AiChatSession {
  id        String          @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  role      String        // user, assistant
  content   String
  createdAt DateTime      @default(now())
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InsightConfig {
  id          String      @id @default(uuid())
  insightType InsightType @default(ANOMALY_DETECTION)
  targetTable String      @default("system")
  metric      String      @default("health_check")
  frequency   String      @default("daily")        // daily, weekly
  parameters  Json?       // Config tambahan per tipe insight
  teamId      String?     // Scope per tim (null = system-wide)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  results     InsightResult[]
}

model InsightResult {
  id          String        @id @default(uuid())
  configId    String
  insightType InsightType
  insightText String        @db.Text
  metadata    Json?         // Data numerik pendukung (tren pct, anomaly score, dll)
  generatedAt DateTime      @default(now())
  config      InsightConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

enum InsightType {
  TREND_ANALYSIS
  ANOMALY_DETECTION
  PERIOD_COMPARISON
  FORECAST
}

// ==========================================
// 13 & 14. WAREHOUSE & TABLE MANAGER (unified model)
// ==========================================
// ManagedTable adalah model tunggal untuk keduanya.
// Warehouse route (/warehouse/tables) dan Table Manager route (/tables) share model ini.
model ManagedTable {
  id            String     @id @default(uuid())
  name          String     @unique
  columns       Json?      // [{name: string, type: string, required?: boolean}]
  retentionDays Int?       // null = simpan selamanya (fitur Warehouse)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  rows          TableRow[]
}

model TableRow {
  id             String       @id @default(uuid())
  managedTableId String
  data           Json
  createdAt      DateTime     @default(now())
  table          ManagedTable @relation(fields: [managedTableId], references: [id], onDelete: Cascade)
}

// ==========================================
// 15. SUBSCRIPTION & USAGE TRACKING
// ==========================================
// Model Subscription dihapus — billing state sudah ada di model Team (stripeCustomerId, subscriptionPlan, dll)
// Tidak ada UserSubscription karena billing per-Tim, bukan per-User

// Model ini digunakan untuk mencatat log historis (Audit pemakaian harian)
model UsageMetric {
  id          String   @id @default(uuid())
  teamId      String   // Diubah dari tenantId menjadi teamId
  metricType  String   // enum/string: AI_TOKEN, QUERY_RUN, AIRBYTE_SYNC
  value       Int      // Jumlah yang dipakai saat aksi terjadi
  loggedAt    DateTime @default(now())

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ==========================================
// 16. INTEGRATION
// ==========================================
model Integration {
  id          String          @id @default(uuid())
  name        String
  provider    String          // 'google_sheets' | 'excel' | 'looker_studio' | 'power_bi'
  apiKey      String?         // Optional: encrypted at-rest (future improvement)
  status      IntegrationStatus @default(ACTIVE)
  teamId      String?         // Null = integrasi global (system-wide)
  config      Json?           // Provider-specific config (sheetId, tabName, dll)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  team            Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  linkedDocuments LinkedDocument[]
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model LinkedDocument {
  id            String      @id @default(uuid())
  integrationId String
  documentUrl   String
  documentName  String?     // Nama dokumen untuk display
  documentType  String?     // 'spreadsheet' | 'workbook' | 'dashboard'
  createdAt     DateTime    @default(now())

  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model Template {
  id           String   @id @default(uuid())
  name         String
  provider     String?  // 'google_sheets' | 'excel' | 'power_bi' | null = generic
  description  String?  // Deskripsi singkat template
  content      Json     // Template config/query
  configSchema Json?    // JSON Schema untuk validasi config saat apply
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// 17. NOTIFICATION
// ==========================================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id        String   @id @default(uuid())
  metric    String
  condition String   // >, <, ==
  threshold Float
  createdAt DateTime @default(now())
}

model AlertTrigger {
  id          String   @id @default(uuid())
  ruleId      String
  triggeredValue Float
  triggeredAt DateTime @default(now())
}

// ==========================================
// 18. SYSTEM
// ==========================================
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   String?
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}

model InfrastructureNode {
  id        String   @id @default(uuid())
  name      String
  type      String
  status    String   @default("Online")
  uptime    String   @default("0d 0h")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model RateLimitConfig {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  limit     Int
  windowMs  Int
}

// ==========================================
// 19. SYNCED DATA (Airbyte Destination)
// ==========================================
// Tabel universal untuk menampung data yang di-sync dari Airbyte.
// Setiap baris mewakili satu record dari source manapun.
model SyncedData {
  id            String   @id @default(uuid())
  connectionId  String   // FK ke Connection (source mana yang ngasih data ini)
  streamName    String   // Nama tabel/stream dari source (misal: "campaigns", "orders")
  recordData    Json     // Data aslinya dalam format JSON
  syncedAt      DateTime @default(now())
  abGenerationId Int?    // Internal Airbyte field untuk deduplikasi

  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([streamName])
  @@map("synced_data") // Nama tabel di PostgreSQL
}

// ==========================================
// 20. OAUTH TOKEN (Untuk koneksi source OAuth)
// ==========================================
model OAuthToken {
  id            String   @id @default(uuid())
  dataSourceId  String   @unique
  provider      String   // "google", "facebook", dll.
  accessToken   String   // Encrypted
  refreshToken  String?  // Encrypted
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}