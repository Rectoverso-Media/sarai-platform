datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String 
}

model DataSource {
  id          String   @id @default(uuid())
  name        String
  type        String
  host        String?
  connectorId String?  // Khusus buat ID dari Airbyte nanti
  status      String   @default("Connected")
  createdAt   DateTime @default(now())
}


model InfrastructureNode {
  id        String   @id @default(uuid())
  name      String   // misal: "Core Engine Alpha"
  type      String   // misal: "GPU Node", "CPU Node"
  status    String   @default("Online") // Online, Warning, Critical, Offline
  uptime    String   @default("0d 0h")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model TeamMember {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   // Owner, Admin, Developer, Viewer
  status    String   @default("Active")
  avatar    String?  // URL foto profil (optional)
  createdAt DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  action    String   // Contoh: "USER_LOGIN", "NODE_DEPLOYED", "DATA_DELETED"
  actor     String   // Siapa pelakunya, misal: "Admin" atau "System"
  details   String?  // Info tambahan: "Menghapus Database Dummy"
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}