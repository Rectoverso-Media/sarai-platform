generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String?
  name            String
  role            Role     @default(VIEWER)
  isEmailVerified Boolean  @default(false)
  refreshToken    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   User[]
}

model DataSource {
  id              String         @id @default(uuid())
  name            String
  sourceType      String
  connectorName   String?
  airbyteSourceId String?        @unique
  airbyteHost     String?
  status          String         @default("Connected")
  trialStartsAt   DateTime       @default(now())
  trialEndsAt     DateTime
  isTrialActive   Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  transfers       DataTransfer[]
}

model InfrastructureNode {
  id        String   @id @default(uuid())
  name      String
  type      String
  status    String   @default("Online")
  uptime    String   @default("0d 0h")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecurityLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   String?
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}

model Query {
  id          String           @id @default(uuid())
  name        String
  description String?
  rawSql      String?
  builderData Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  executions  QueryExecution[]
  schedules   QuerySchedule?
}

model QueryExecution {
  id           String   @id @default(uuid())
  queryId      String
  status       String
  durationMs   Int?
  rowsReturned Int?
  errorMessage String?
  executedAt   DateTime @default(now())
  query        Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model QuerySchedule {
  id             String    @id @default(uuid())
  queryId        String    @unique
  cronExpression String
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  query          Query     @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model DataTransfer {
  id             String     @id @default(uuid())
  name           String
  sourceId       String
  targetType     String     @default("Google Sheets")
  spreadsheetId  String
  sheetName      String
  writeMode      String     @default("append")
  cronExpression String?
  lastExportAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  source         DataSource @relation(fields: [sourceId], references: [id])
}

model Dashboard {
  id        String   @id @default(uuid())
  name      String   @default("My Custom Dashboard")
  widgets   Json
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
