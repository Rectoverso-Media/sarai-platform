datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String 
}

model DataSource {
  id          String   @id @default(uuid())
  name        String
  type        String
  host        String?
  connectorId String?  // Khusus buat ID dari Airbyte nanti
  status      String   @default("Connected")
  createdAt   DateTime @default(now())
}
