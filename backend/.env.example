# ===========================================================
# SARAI PLATFORM — Environment Variables Template
# ===========================================================
# SALIN file ini menjadi .env dan isi dengan nilai nyata.
# JANGAN pernah commit file .env ke version control!
# ===========================================================

# --- DATABASE ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# --- REDIS (Upstash atau self-hosted) ---
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# --- JWT ---
# Gunakan string random minimal 64 karakter. Generate: openssl rand -base64 64
JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_MINIMAL_64_KARAKTER

# --- AIRBYTE CLOUD ---
AIRBYTE_CLIENT_ID=your-airbyte-client-id
AIRBYTE_CLIENT_SECRET=your-airbyte-client-secret
AIRBYTE_REFRESH_TOKEN=your-airbyte-refresh-token
AIRBYTE_WORKSPACE_ID=your-airbyte-workspace-id

# --- GOOGLE OAUTH (untuk login dengan Google) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- EMAIL / SMTP ---
SMTP_USER=your-email@gmail.com
# Gunakan App Password Google, bukan password asli akun Gmail
SMTP_PASS=your-16-char-google-app-password

# --- AI CONFIGURATION ---
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# --- GOOGLE SERVICE ACCOUNT (untuk Google Sheets Export) ---
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste full private key termasuk header/footer, replace \n dengan \\n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- STRIPE BILLING ---
STRIPE_SECRET_KEY=sk_test_or_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_your_key_here
STRIPE_PRODUCT_PRO=prod_your_pro_product_id
STRIPE_PRODUCT_ENTERPRISE=prod_your_enterprise_product_id
# Dapatkan dari: stripe listen --forward-to localhost:3001/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- FRONTEND URL ---
FRONTEND_URL=http://localhost:3000

# --- QUOTA LIMITS PER PLAN ---
QUOTA_FREE_QUERIES=1000
QUOTA_FREE_AI_TOKENS=10000
QUOTA_FREE_STORAGE_MB=500
QUOTA_FREE_AIRBYTE_SYNCS=5

QUOTA_PRO_QUERIES=50000
QUOTA_PRO_AI_TOKENS=500000
QUOTA_PRO_STORAGE_MB=10240
QUOTA_PRO_AIRBYTE_SYNCS=100

# ENTERPRISE = -1 berarti unlimited
QUOTA_ENTERPRISE_QUERIES=-1
QUOTA_ENTERPRISE_AI_TOKENS=-1
QUOTA_ENTERPRISE_STORAGE_MB=-1
QUOTA_ENTERPRISE_AIRBYTE_SYNCS=-1
